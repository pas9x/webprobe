<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="270.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.pascalhp.webprobe.controllers.AboutWindowController">
   <center>
      <TextArea fx:id="aboutText" editable="false" prefHeight="200.0" prefWidth="200.0" text="%about_window.about" wrapText="true" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin></TextArea>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#onCloseButtonClick" text="%about_window.close" />
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </HBox>
   </bottom>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <top>
      <BorderPane prefHeight="64.0" prefWidth="430.0" BorderPane.alignment="CENTER">
         <center>
            <Label text="WebProbe" BorderPane.alignment="CENTER_LEFT">
               <font>
                  <Font size="30.0" />
               </font>
               <BorderPane.margin>
                  <Insets left="20.0" />
               </BorderPane.margin>
            </Label>
         </center>
         <left>
             <ImageView fitHeight="64.0" fitWidth="64.0" onMouseClicked="#onAppIconClick" pickOnBounds="true" preserveRatio="true">
                 <image>
                     <Image url="@../icons/app-icon.png" />
                 </image>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
             </ImageView>
         </left>
         <BorderPane.margin>
            <Insets bottom="6.0" />
         </BorderPane.margin>
      </BorderPane>
   </top>
</BorderPane>
